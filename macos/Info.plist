<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>app.truenrth.forzac</string>
  <key>CFBundleName</key><string>Forzac</string>
  <key>CFBundleDisplayName</key><string>Forzac</string>
  <!-- The interface is in English and Russian: the system's own panels (open, share, alerts) follow the language. -->
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key><array><string>en</string><string>ru</string></array>
  <key>CFBundleExecutable</key><string>Forzac</string>
  <key>CFBundleIconFile</key><string>Forzac</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.9.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <!-- Updates (macos-auto-update): Sparkle installs the latest release's signed disk image when the library's
       "install" is clicked; it never checks on its own (the core's daily check does). -->
  <key>SUFeedURL</key><string>https://github.com/denisfl/forzac-desktop/releases/latest/download/appcast.xml</string>
  <key>SUPublicEDKey</key><string>NZGAqdxEDb4tFmAJwKTZcI3/JH2aekxc7kWwUWlnDQU=</string>
  <key>SUEnableAutomaticChecks</key><false/>
  <key>NSHumanReadableCopyright</key><string>Mozilla Public License 2.0</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>EPUB book</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>org.idpf.epub-container</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>FictionBook</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>LSItemContentTypes</key><array><string>org.gribuser.fictionbook</string><string>ru.litres.fb3</string></array>
    </dict>
    <dict>
      <!-- Text and Markdown (markdown-txt): offered in "Open With", never taking them over from editors. -->
      <key>CFBundleTypeName</key><string>Text</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>public.plain-text</string><string>net.daringfireball.markdown</string></array>
    </dict>
    <dict>
      <!-- .fb2.zip is a zip to macOS: Forzac is offered in "Open With" without taking zips over. -->
      <key>CFBundleTypeName</key><string>Zipped FictionBook</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>public.zip-archive</string></array>
    </dict>
  </array>
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>net.daringfireball.markdown</string>
      <key>UTTypeDescription</key><string>Markdown</string>
      <key>UTTypeConformsTo</key><array><string>public.plain-text</string></array>
      <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>md</string><string>markdown</string></array><key>public.mime-type</key><array><string>text/markdown</string></array></dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>org.gribuser.fictionbook</string>
      <key>UTTypeDescription</key><string>FictionBook</string>
      <key>UTTypeConformsTo</key><array><string>public.xml</string></array>
      <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>fb2</string></array></dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>ru.litres.fb3</string>
      <key>UTTypeDescription</key><string>FictionBook 3</string>
      <key>UTTypeConformsTo</key><array><string>public.zip-archive</string></array>
      <key>UTTypeTagSpecification</key><dict><key>public.filename-extension</key><array><string>fb3</string></array></dict>
    </dict>
  </array>
</dict>
</plist>
