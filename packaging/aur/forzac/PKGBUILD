# Maintainer: denisfl
# Builds from the source of a tagged release; links the system GTK 4. At publication: updpkgsums, then
# makepkg --printsrcinfo > .SRCINFO.
pkgname=forzac
pkgver=0.15.0
pkgrel=1
pkgdesc="Offline FB2 and EPUB reader with book-quality typesetting"
arch=(x86_64 aarch64)
url="https://forzac.app"
license=(MPL-2.0 OFL-1.1 LPPL-1.2)
# perl-file-mimeinfo gives xdg-open (outside GNOME/KDE, e.g. on Hyprland) types by file name, as file managers do;
# without it `xdg-open book.fb2` sees text/xml by content (Omarchy opens that in nvim) and .fb2.zip as application/zip.
depends=(gtk4 fontconfig perl-file-mimeinfo)
makedepends=(cargo)
install=forzac.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/denisfl/forzac-desktop/archive/v$pkgver.tar.gz")
sha256sums=('c3c38e89ef2782330efea30730d955416c9cbf281d79c5131886644e6edbff1e')

build() {
  cd "forzac-desktop-$pkgver"
  cargo build --release --locked -p forzac-gtk
}

package() {
  cd "forzac-desktop-$pkgver"
  install -Dm755 target/release/forzac "$pkgdir/usr/bin/forzac"
  install -d "$pkgdir/usr/share/forzac" "$pkgdir/usr/share/icons"
  cp -r assets/fonts "$pkgdir/usr/share/forzac/"
  # pacman updates it: the app does not check GitHub for a newer release.
  install -Dm644 /dev/null "$pkgdir/usr/share/forzac/packaged"
  cp -r data/icons/hicolor "$pkgdir/usr/share/icons/"
  install -Dm644 data/app.truenrth.forzac.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 data/forzac-mime.xml "$pkgdir/usr/share/mime/packages/forzac.xml"
  install -Dm644 LICENSE assets/hyph/hyph-ru.lic.txt assets/hyph/hyph-en-us.lic.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
  for f in pt-serif pt-sans literata source-serif pt-mono golos-text; do
    install -Dm644 "assets/fonts/$f/OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/$f-OFL.txt"
  done
}
