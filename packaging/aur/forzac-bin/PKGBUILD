# Maintainer: denisfl
# The release archives (scripts/package-linux.sh) copied to /usr. At publication: updpkgsums, then
# makepkg --printsrcinfo > .SRCINFO.
pkgname=forzac-bin
pkgver=0.10.1
pkgrel=1
pkgdesc="Offline FB2 and EPUB reader with book-quality typesetting (release build)"
arch=(x86_64 aarch64)
url="https://forzac.truenrth.app"
license=(MPL-2.0 OFL-1.1 LPPL-1.2)
# perl-file-mimeinfo: see the forzac package.
depends=(gtk4 fontconfig perl-file-mimeinfo)
provides=(forzac)
conflicts=(forzac)
install=forzac.install
options=(!debug)
_release=https://github.com/denisfl/forzac-desktop/releases/download/v$pkgver
# The release files have no version in their names (stable download links); saved under one here.
source_x86_64=("forzac-$pkgver-linux-x86_64.tar.gz::$_release/forzac-linux-x86_64.tar.gz")
source_aarch64=("forzac-$pkgver-linux-aarch64.tar.gz::$_release/forzac-linux-aarch64.tar.gz")
sha256sums_x86_64=('2d218531c81c3989d628ca446c378abc9cb00497ec2390db5688794214f27011')
sha256sums_aarch64=('81cf2467cf843610523ff001528d0dbe0aaa00c57d179b2164cac24ace808d46')

package() {
  install -d "$pkgdir/usr"
  cp -r "forzac-$pkgver-linux-$CARCH"/{bin,share} "$pkgdir/usr/"
  # pacman updates it: the app does not check GitHub for a newer release.
  install -Dm644 /dev/null "$pkgdir/usr/share/forzac/packaged"
  # The licences under the package's own name, where pacman looks for them.
  mv "$pkgdir/usr/share/licenses/forzac" "$pkgdir/usr/share/licenses/$pkgname"
}
