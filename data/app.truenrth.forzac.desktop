[Desktop Entry]
Type=Application
Name=Forzac
Name[ru]=Форзац
GenericName=Book Reader
GenericName[ru]=Читалка
Comment=Offline reader for FB2 and EPUB books
Comment[ru]=Офлайн-читалка FB2 и EPUB
Exec=forzac %F
Icon=app.truenrth.forzac
Terminal=false
Categories=Office;Viewer;Literature;
