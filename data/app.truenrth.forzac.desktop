[Desktop Entry]
Type=Application
Name=Forzac
Name[ru]=Форзац
GenericName=Book Reader
GenericName[ru]=Читалка
Comment=Offline reader for FB2, EPUB, TXT and Markdown books
Comment[ru]=Офлайн-читалка FB2, EPUB, TXT и Markdown
Exec=forzac %F
Icon=app.truenrth.forzac
Terminal=false
Categories=Office;Viewer;
MimeType=application/x-fictionbook+xml;application/x-zip-compressed-fb2;application/x-fb3;application/epub+zip;text/markdown;
Keywords=book;reader;ebook;fb2;epub;txt;markdown;читалка;книга;
StartupNotify=true
