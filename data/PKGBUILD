# Sketch of the AUR package (not yet tested on Arch). Builds from source; links the system GTK 4.
pkgname=forzac
pkgver=0.1.0
pkgrel=1
pkgdesc="Offline FB2 and EPUB reader with book-quality typesetting"
arch=(x86_64 aarch64)
url="https://forzac.truenrth.app"
license=(TBD)
# perl-file-mimeinfo gives xdg-open (outside GNOME/KDE, e.g. on Hyprland) types by file name, as file managers do;
# without it `xdg-open book.fb2` sees text/xml by content (Omarchy opens that in nvim) and .fb2.zip as application/zip.
depends=(gtk4 fontconfig perl-file-mimeinfo)
makedepends=(cargo)
source=("$pkgname-$pkgver.tar.gz::https://github.com/<owner>/forzac-desktop/archive/v$pkgver.tar.gz")
sha256sums=(SKIP)

build() {
  cd "forzac-desktop-$pkgver"
  cargo build --release --locked -p forzac-gtk
}

package() {
  cd "forzac-desktop-$pkgver"
  install -Dm755 target/release/forzac "$pkgdir/usr/bin/forzac"
  install -d "$pkgdir/usr/share/forzac"
  cp -r assets/fonts "$pkgdir/usr/share/forzac/"
  install -Dm644 data/app.truenrth.forzac.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 data/forzac-mime.xml "$pkgdir/usr/share/mime/packages/forzac.xml"
  for f in pt-serif pt-sans literata source-serif; do
    install -Dm644 "assets/fonts/$f/OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/$f-OFL.txt"
  done
  install -Dm644 assets/hyph/hyph-ru.lic.txt assets/hyph/hyph-en-us.lic.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
